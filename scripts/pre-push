#!/usr/bin/env bash
# Installed by `make hooks`. For each pushed ref:
#   1. the restricted-path guard on EVERY commit the remote does not have yet (so a file added and later deleted
#      is still caught), each judged on its own tree;
#   2. the full gate (`make check`) on the tip, in a temporary worktree, so it judges what is pushed, not the
#      working copy. The orphan `data` branch holds no code, so step 1 is its whole gate.
set -euo pipefail
# The main checkout (where .venv and the guard live), even when pushing from a linked worktree.
top="$(cd "$(git rev-parse --path-format=absolute --git-common-dir)/.." && pwd)"
zero="0000000000000000000000000000000000000000"
status=0
tmp=""
cleanup() {
  if [ -n "$tmp" ]; then
    git -C "$top" worktree remove --force "$tmp/tree" 2>/dev/null || true
    rm -rf "$tmp"
    tmp=""
  fi
}
trap cleanup EXIT INT TERM
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # a deletion: nothing to check
  branch="${remote_ref#refs/heads/}"
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  echo "pre-push: checking $local_ref -> $branch"
  # shellcheck disable=SC2086  # $range is two words on purpose for a new branch
  if ! commits="$(git -C "$top" rev-list $range)"; then
    echo "pre-push: cannot list the commits to push" >&2
    status=1
    continue
  fi
  for commit in $commits; do
    if ! (cd "$top" && GATE_BRANCH="$branch" .venv/bin/python scripts/check_restricted.py --range "$commit^!"); then
      status=1
    fi
  done
  if [ "$branch" = "data" ]; then
    # The orphan data branch holds no code to test: the per-commit guard above is its whole gate.
    [ "$status" = 0 ] || echo "pre-push: the gate failed for $local_ref; nothing was pushed" >&2
    continue
  fi
  tmp="$(mktemp -d)"
  git -C "$top" worktree add -q --detach "$tmp/tree" "$local_sha"
  ln -s "$top/.venv" "$tmp/tree/.venv"
  if ! (cd "$tmp/tree" && GATE_BRANCH="$branch" make -s check); then
    status=1
  fi
  cleanup
  [ "$status" = 0 ] || echo "pre-push: the gate failed for $local_ref; nothing was pushed" >&2
done
exit "$status"
