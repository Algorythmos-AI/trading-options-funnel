#!/usr/bin/env bash
# Run the gate on exactly what is being pushed: each pushed commit is checked out in a temporary worktree and
# `make check` runs there, with GATE_BRANCH set to the branch it is pushed as. Installed by `make hooks`.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # a branch deletion: nothing to check
  branch="${remote_ref#refs/heads/}"
  tmp="$(mktemp -d)"
  git -C "$top" worktree add -q --detach "$tmp/tree" "$local_sha"
  ln -s "$top/.venv" "$tmp/tree/.venv"
  echo "pre-push: checking $local_sha ($local_ref -> $branch)"
  if ! (cd "$tmp/tree" && GATE_BRANCH="$branch" make -s check); then
    echo "pre-push: the gate failed for $local_ref; nothing was pushed" >&2
    status=1
  fi
  git -C "$top" worktree remove --force "$tmp/tree"
  rm -rf "$tmp"
done
exit "$status"
